<Window x:Class="CloudDrive.App.Views.StaleFolderWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CloudDrive.App.Localization"
        Title="{loc:Loc App_Name}"
        Icon="pack://application:,,,/Resources/selbstlaeufer-cloud-app-icon-1024px.png"
        Width="400"
        Height="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <TextBlock Text="{loc:Loc StaleFolderWarning_Message}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>
