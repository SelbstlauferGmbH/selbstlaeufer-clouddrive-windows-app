<Window x:Class="CloudDrive.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CloudDrive.App.Localization"
        xmlns:vm="clr-namespace:CloudDrive.App.ViewModels"
        xmlns:local="clr-namespace:CloudDrive.App.Views"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Resources/selbstlaeufer-cloud-app-icon-1024px.png"
        Width="980"
        Height="660"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <local:SectionVisibilityConverter x:Key="SectionVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <CollectionViewSource x:Key="GroupedNavigationItems" Source="{Binding NavigationItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <DataTemplate x:Key="DistributionChartBarTemplate" DataType="{x:Type vm:SimpleChartBar}">
            <Grid Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="10"
                            Height="10"
                            Margin="0,3,10,0"
                            CornerRadius="3"
                            Background="{Binding Fill}"
                            VerticalAlignment="Top"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Label}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>

                    <TextBlock Grid.Column="2"
                               Margin="12,0,0,0"
                               Text="{Binding DisplayValue}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                </Grid>

                <Border Grid.Row="1"
                        Height="10"
                        Margin="20,8,0,0"
                        Background="{DynamicResource Theme.SurfaceAltBrush}"
                        CornerRadius="5">
                    <Grid HorizontalAlignment="Stretch"
                          RenderTransformOrigin="0,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Ratio}"/>
                        </Grid.RenderTransform>
                        <Border Background="{Binding Fill}" CornerRadius="5"/>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="ChromeScrollTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeScrollThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource Theme.ScrollThumbBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbVisual"
                                Margin="1"
                                MinWidth="8"
                                MinHeight="8"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource Theme.ScrollThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource Theme.ScrollThumbDraggingBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThumbVisual" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root"
                              Background="Transparent"
                              Margin="0,0,2,0"
                              SnapsToDevicePixels="True">
                            <Border x:Name="TrackBackground"
                                    Margin="3,0,2,0"
                                    Background="{DynamicResource Theme.ScrollTrackBrush}"
                                    CornerRadius="3"/>
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True"
                                   Margin="3,0,2,0"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ChromeScrollTrackButtonStyle}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ChromeScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ChromeScrollTrackButtonStyle}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource Theme.ScrollTrackHoverBrush}"/>
                            </Trigger>
                            <Trigger SourceName="PART_Track" Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource Theme.ScrollTrackFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource Theme.ScrollTrackFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="Margin" Value="2,0,2,2"/>
                                <Setter TargetName="TrackBackground" Property="Margin" Value="0,3,0,2"/>
                                <Setter TargetName="PART_Track" Property="Margin" Value="0,3,0,2"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="14"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="14"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="SidebarListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="{Binding PromotionBackground}"
                                BorderBrush="{Binding PromotionBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="28" Height="28" CornerRadius="8" Background="{Binding GlyphBackground}">
                                    <TextBlock Text="{Binding Glyph}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{Binding GlyphForeground}"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Background="{Binding BadgeBackground}"
                                        CornerRadius="9"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding BadgeText, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.SurfaceAltBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.SelectionBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.SelectionBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentTextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.LinkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Theme.SurfaceAltBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{loc:Loc App_ControlPanel_Sidebar}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding AccountDisplay}" Margin="0,4,0,14" FontSize="12" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             MinHeight="0"
                             SelectedItem="{Binding SelectedNavigationItem}"
                             ItemsSource="{Binding Source={StaticResource GroupedNavigationItems}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Style="{StaticResource SidebarListBoxStyle}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,16,0,8"
                                                    Visibility="{Binding Name, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Border Height="1" Background="{DynamicResource Theme.BorderBrush}"/>
                                            <TextBlock Text="{Binding Name}" Margin="0,10,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Activity}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Navigation_Activity_Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Loc Section_Activity_Subtitle}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{loc:Loc Section_Activity_ExportCsv}" Padding="14,8" Click="ExportCsv_Click"/>
                            </Grid>

                            <TextBox Margin="0,20,0,0"
                                     Padding="12,8"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="{loc:Loc Section_Activity_ActionFilters}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding ActionFilters}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" Click="ActionFilter_Click" Style="{StaticResource PillButtonStyle}">
                                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{loc:Loc Section_Activity_FileTypeFilters}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding FileTypeFilters}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" Click="FileTypeFilter_Click" Style="{StaticResource PillButtonStyle}">
                                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding ActivityGroups}" Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ActivityDayGroup}">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMutedBrush}"/>
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ActivityDisplayItem}">
                                                        <Border BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,10" MouseLeftButtonUp="ActivityItem_MouseLeftButtonUp">
                                                            <Grid Cursor="Hand">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="42" Height="42" CornerRadius="12" Background="{Binding BadgeBackground}">
                                                                    <TextBlock Text="{Binding BadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                        <TextBlock Text="{Binding SubtitlePrefix}" FontSize="11" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                                                        <Button Content="{Binding LocationDisplay}" Tag="{Binding}" Click="LocationLink_Click" Style="{StaticResource FlatLinkButtonStyle}" Margin="4,0,0,0" Visibility="{Binding HasLocationLink, Converter={StaticResource BoolToVisibility}}"/>
                                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Theme.TextSecondaryBrush}" Visibility="{Binding HasSubtitleOnly, Converter={StaticResource BoolToVisibility}}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding RelativeTime}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Theme.TextMutedBrush}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button Content="{loc:Loc Common_Previous}" Padding="12,6" Margin="0,0,8,0" Click="PreviousPage_Click" IsEnabled="{Binding CanGoPreviousPage}"/>
                                <ItemsControl ItemsSource="{Binding ActivityPageNumbers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Tag="{Binding}" Padding="10,6" Margin="0,0,8,0" Click="PageNumber_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{loc:Loc Common_Next}" Padding="12,6" Click="NextPage_Click" IsEnabled="{Binding CanGoNextPage}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Problems}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <TextBlock Text="{loc:Loc Navigation_Problems_Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Loc Section_Problems_Subtitle}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>

                            <Border Margin="0,18,0,0" Padding="18" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16" Background="{DynamicResource Theme.SurfaceAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Section_Problems_CenterTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ProblemSummary}" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ProblemItems}" Margin="0,18,0,0" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProblemDisplayItem}">
                                        <Border BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12" Background="{Binding BackgroundBrush}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" Margin="0,4,10,0"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding KindLabel}" Margin="20,6,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ForegroundBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding RelativeTime}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Theme.TextMutedBrush}"/>
                                                </DockPanel>

                                                <TextBlock Text="{Binding Summary}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Detail}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.TextSecondaryBrush}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding OccurrenceText}" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource Theme.TextMutedBrush}"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <TextBlock Text="{loc:Loc Common_Location}" FontSize="11" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                                    <Button Content="{Binding LocationDisplay}"
                                                            Tag="{Binding}"
                                                            Click="ProblemLocationLink_Click"
                                                            Style="{StaticResource FlatLinkButtonStyle}"
                                                            Margin="6,0,0,0"
                                                            Visibility="{Binding HasLocationLink, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>

                                                <WrapPanel Margin="0,14,0,0">
                                                    <Button Content="{Binding PrimaryAction.Label}"
                                                            Tag="{Binding PrimaryAction}"
                                                            Click="ProblemAction_Click"
                                                            Padding="12,6"
                                                            Margin="0,0,8,8"
                                                            Visibility="{Binding HasPrimaryAction, Converter={StaticResource BoolToVisibility}}"/>
                                                    <Button Content="{Binding SecondaryAction.Label}"
                                                            Tag="{Binding SecondaryAction}"
                                                            Click="ProblemAction_Click"
                                                            Padding="12,6"
                                                            Margin="0,0,8,8"
                                                            Visibility="{Binding HasSecondaryAction, Converter={StaticResource BoolToVisibility}}"/>
                                                    <Button Content="{Binding DismissAction.Label}"
                                                            Tag="{Binding DismissAction}"
                                                            Click="ProblemAction_Click"
                                                            Style="{StaticResource FlatLinkButtonStyle}"
                                                            Margin="0,4,8,8"
                                                            Visibility="{Binding HasDismissAction, Converter={StaticResource BoolToVisibility}}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,18,0,0" Padding="24" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16" Visibility="{Binding HasNoProblems, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Section_Problems_EmptyTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Section_Problems_EmptyDescription}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.TextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Statistics}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <TextBlock Text="{loc:Loc Navigation_Statistics_Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Loc Section_Statistics_Subtitle}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>

                            <ItemsControl ItemsSource="{Binding RangeFilters}" Margin="0,18,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="RangeFilter_Click" Style="{StaticResource PillButtonStyle}">
                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding StatisticsCards}" Margin="0,18,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DashboardMetricCard}">
                                        <Border Margin="0,0,12,0" Padding="16" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Value}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Subtext}" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Margin="0,0,12,0" Padding="18" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Section_Statistics_StatusDistribution}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding StatusChartItems}"
                                                      ItemTemplate="{StaticResource DistributionChartBarTemplate}"
                                                      Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Padding="18" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Section_Statistics_ActivityDistribution}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding ActivityChartItems}"
                                                      ItemTemplate="{StaticResource DistributionChartBarTemplate}"
                                                      Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{loc:Loc Section_Statistics_FootprintTitle}"
                                       Margin="0,28,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Loc Section_Statistics_FootprintDescription}"
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Margin="0,0,12,0" Padding="18" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Section_Statistics_TrackedStorageTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding StorageSummary}" Margin="0,12,0,0" FontSize="14" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding StorageSuggestion}" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Padding="18" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16">
                                    <StackPanel>
                                    <TextBlock Text="{loc:Loc Section_Statistics_PathsTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Loc Section_Statistics_SyncRoot}" Margin="0,12,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SyncRootPath}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Loc Section_Statistics_DataDirectory}" Margin="0,12,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding DataDirectoryDisplay}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Loc Section_Statistics_LogFiles}" Margin="0,12,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding LogPathDisplay}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Margin="0,24,0,0" Padding="18" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Section_Statistics_CurrentIndexTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DatabaseStatistics.DatabasePath}" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DatabaseStatistics.DatabaseSizeDisplay}" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DatabaseStatistics.LastSyncedDisplay}" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=HealthCheck}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Navigation_HealthCheck_Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Loc Section_Health_Subtitle}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Content="{loc:Loc Section_Health_RunAllChecks}" DockPanel.Dock="Right" Padding="14,8" Click="RunAllChecks_Click"/>
                            </DockPanel>

                            <TextBlock Text="{Binding HealthLastChecked}" Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource Theme.TextMutedBrush}"/>

                            <ItemsControl ItemsSource="{Binding HealthChecks}" Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DashboardHealthCheck}">
                                        <Border BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Width="12" Height="12" Fill="{Binding AccentBrush}" Margin="0,4,16,0"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Description}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding LastCheckedText}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource Theme.TextMutedBrush}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Top" Margin="0,0,16,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>

                                                <Button Grid.Column="3"
                                                        Tag="{Binding ActionId}"
                                                        Content="{Binding ActionLabel}"
                                                        Click="HealthAction_Click"
                                                        Style="{StaticResource FlatLinkButtonStyle}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=General}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <TextBlock Text="{loc:Loc Navigation_General_Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Loc Section_General_Subtitle}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>

                            <Border Margin="0,20,0,0" Padding="18" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16">
                                <StackPanel>
                                    <CheckBox Content="{loc:Loc Section_General_LaunchOnStartup}" IsChecked="{Binding LaunchOnStartup}" FontSize="12"/>
                                    <CheckBox Content="{loc:Loc Section_General_ShowNotifications}" IsChecked="{Binding ShowNotifications}" Margin="0,10,0,0" FontSize="12"/>

                                    <TextBlock Text="{loc:Loc Common_Theme}" Margin="0,16,0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding ThemeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding ThemeMode}"/>

                                    <TextBlock Text="{loc:Loc Common_Language}" Margin="0,16,0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Language}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Account}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <TextBlock Text="{loc:Loc Navigation_Account_Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Loc Section_Account_Subtitle}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>

                            <TextBlock Text="{loc:Loc Section_Account_WebDavUrl}" Margin="0,20,0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                            <TextBox Text="{Binding WebDavUrl, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>

                            <TextBlock Text="{loc:Loc Section_Account_Username}" Margin="0,16,0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>

                            <TextBlock Text="{loc:Loc Section_Account_Password}" Margin="0,16,0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Padding="10,8"
                                         GotFocus="PasswordBox_GotFocus"
                                         LostFocus="PasswordBox_LostFocus"/>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="{loc:Loc Section_Account_TestConnection}"
                                        Padding="14,8"
                                        Margin="0,0,10,0"
                                        Click="TestConnection_Click"
                                        IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"/>
                                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Network}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <TextBlock Text="{loc:Loc Navigation_Network_Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Loc Section_Network_Subtitle}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>

                            <TextBlock Text="{loc:Loc Section_Network_PollingInterval}" Margin="0,20,0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                            <TextBox Text="{Binding SyncIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>

                            <TextBlock Text="{loc:Loc Section_Network_MaxConcurrentTransfers}" Margin="0,16,0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                            <TextBox Text="{Binding MaxConcurrentTransfers, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Advanced}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <TextBlock Text="{loc:Loc Navigation_Advanced_Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Loc Section_Advanced_Subtitle}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>

                            <Border Margin="0,20,0,0" Padding="18" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="16">
                                <StackPanel>
                                    <CheckBox Content="{loc:Loc Section_Advanced_EnableFileLogging}" IsChecked="{Binding EnableFileLogging}" FontSize="12"/>
                                    <TextBlock Text="{loc:Loc Section_Advanced_FileLoggingDescription}"
                                               Margin="0,10,0,0"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Theme.TextSecondaryBrush}"/>
                                    <Button Content="{loc:Loc Section_Advanced_ForceCrash}"
                                            Margin="0,16,0,0"
                                            Padding="14,8"
                                            Click="CrashButton_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,20,0,0" Padding="18" BorderBrush="{DynamicResource Theme.DangerBorderBrush}" BorderThickness="1" CornerRadius="16" Background="{DynamicResource Theme.DangerSurfaceBrush}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Section_Advanced_DangerZone}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Theme.DangerTextBrush}"/>
                                    <TextBlock Text="{loc:Loc Section_Advanced_ResetDescription}"
                                               Margin="0,10,0,0"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Theme.DangerTextBrush}"/>
                                    <TextBlock Text="{loc:Loc Section_Advanced_ResetLocalDescription}"
                                               Margin="0,16,0,0"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Theme.DangerTextBrush}"/>
                                    <Button Content="{loc:Loc Section_Advanced_ResetButton}"
                                            Margin="0,10,0,0"
                                            Padding="14,8"
                                            Background="{DynamicResource Theme.DangerStrongBrush}"
                                            Foreground="White"
                                            BorderBrush="{DynamicResource Theme.DangerStrongBorderBrush}"
                                            HorizontalAlignment="Left"
                                            Click="ResetButton_Click"/>
                                    <TextBlock Text="{loc:Loc Section_Advanced_FullResetDescription}"
                                               Margin="0,18,0,0"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Theme.DangerTextBrush}"/>
                                    <Button Content="{loc:Loc Section_Advanced_FullResetButton}"
                                            Margin="0,10,0,0"
                                            Padding="14,8"
                                            Background="{DynamicResource Theme.DangerStrongBrush}"
                                            Foreground="White"
                                            BorderBrush="{DynamicResource Theme.DangerStrongBorderBrush}"
                                            HorizontalAlignment="Left"
                                            Click="FullResetButton_Click"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                                <Button Content="{loc:Loc Common_Save}" Padding="18,8" Margin="0,0,8,0" Click="Save_Click"/>
                                <Button Content="{loc:Loc Common_Close}" Padding="18,8" Click="CloseButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Theme.SurfaceAltBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource Theme.TextMutedBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource Theme.TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{loc:Loc Common_Help}" Style="{StaticResource FlatLinkButtonStyle}" Click="Help_Click"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource Theme.TextMutedBrush}" VerticalAlignment="Center"/>
                    <Button Content="{loc:Loc Common_Privacy}" Style="{StaticResource FlatLinkButtonStyle}" Click="Privacy_Click"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource Theme.TextMutedBrush}" VerticalAlignment="Center"/>
                    <Button Content="{loc:Loc Common_Terms}" Style="{StaticResource FlatLinkButtonStyle}" Click="Terms_Click"/>
                    <TextBlock Text="     " Foreground="Transparent"/>
                    <Button Content="{loc:Loc Common_Save}" Padding="14,6" Margin="0,0,8,0" Click="Save_Click"/>
                    <Button Content="{loc:Loc Common_Close}" Padding="14,6" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
