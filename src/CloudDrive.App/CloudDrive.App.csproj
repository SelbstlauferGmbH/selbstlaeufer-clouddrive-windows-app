<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>CloudDrive.App.Program</StartupObject>
    <Title>Selbstläufer CloudDrive</Title>
    <Product>Selbstläufer CloudDrive</Product>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <ApplicationIcon>..\..\assets\app_icons\selbstlaeufer-cloud-app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudDrive.Core\CloudDrive.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app_icons\selbstlaeufer-cloud-app-icon.ico" Link="Resources\selbstlaeufer-cloud-app-icon.ico" />
    <Content Include="..\..\assets\app_icons\favicon.ico" Link="Resources\favicon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="..\..\assets\app_icons\selbstlaeufer-cloud-app-icon-512px.png" Link="Resources\selbstlaeufer-cloud-app-icon-512px.png" />
    <Resource Include="..\..\assets\app_icons\selbstlaeufer-cloud-app-icon-1024px.png" Link="Resources\selbstlaeufer-cloud-app-icon-1024px.png" />
    <Resource Include="..\..\assets\app_icons\selbstlaeufer-clouddrive-icon-with-text.png" Link="Resources\selbstlaeufer-clouddrive-icon-with-text.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.3" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <Import Project="..\..\build\IntegrityManifest.targets" />

  <!-- Copy the watchdog into the app output before the integrity manifest runs.
       The manifest hashes whatever is already in $(OutDir), so copying afterward
       can leave the manifest and the actual watchdog binary out of sync. -->
  <Target Name="CopyWatchdogArtifacts" BeforeTargets="_GenerateIntegrityManifest">
    <!-- Build the watchdog on demand instead of referencing it directly so
        app restores/publishes do not need to evaluate its framework graph.
        Restore it explicitly because the app publish restore does not cover
        this unreferenced project. -->
    <MSBuild Projects="..\CloudDrive.Watchdog\CloudDrive.Watchdog.csproj"
         Targets="Restore;Build;GetTargetPath"
             RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishDir"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_WatchdogTargetPath" />
    </MSBuild>

    <PropertyGroup>
      <_WatchdogOutputDirectory>$([System.IO.Path]::GetDirectoryName('%(_WatchdogTargetPath.Identity)'))</_WatchdogOutputDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_WatchdogArtifacts Include="$(_WatchdogOutputDirectory)\CloudDrive.Watchdog.exe" Condition="Exists('$(_WatchdogOutputDirectory)\CloudDrive.Watchdog.exe')" />
      <_WatchdogArtifacts Include="$(_WatchdogOutputDirectory)\CloudDrive.Watchdog.dll" Condition="Exists('$(_WatchdogOutputDirectory)\CloudDrive.Watchdog.dll')" />
      <_WatchdogArtifacts Include="$(_WatchdogOutputDirectory)\CloudDrive.Watchdog.deps.json" Condition="Exists('$(_WatchdogOutputDirectory)\CloudDrive.Watchdog.deps.json')" />
      <_WatchdogArtifacts Include="$(_WatchdogOutputDirectory)\CloudDrive.Watchdog.runtimeconfig.json" Condition="Exists('$(_WatchdogOutputDirectory)\CloudDrive.Watchdog.runtimeconfig.json')" />
      <_WatchdogArtifacts Include="$(_WatchdogOutputDirectory)\CloudDrive.Watchdog.pdb" Condition="Exists('$(_WatchdogOutputDirectory)\CloudDrive.Watchdog.pdb')" />
    </ItemGroup>

    <Copy SourceFiles="@(_WatchdogArtifacts)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_WatchdogArtifacts)' != ''" />
  </Target>

</Project>
