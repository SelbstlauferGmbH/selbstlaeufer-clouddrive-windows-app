# CloudDrive E2E and manual WebDAV test configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
#
# ── Option A: local Docker WebDAV server (recommended for development) ────────
# Start the server first:  docker compose up -d
# Or run everything at once:  tests/run-e2e-local.ps1
#
CLOUDDRIVE_TEST_WEBDAV_URL=http://localhost:8080/
CLOUDDRIVE_TEST_USERNAME=testuser
CLOUDDRIVE_TEST_PASSWORD=testpass

# ── Option B: remote WebDAV server ────────────────────────────────────────────
# CLOUDDRIVE_TEST_WEBDAV_URL=https://your-server.com/dav/
# CLOUDDRIVE_TEST_USERNAME=your_username
# CLOUDDRIVE_TEST_PASSWORD=your_password

# Optional: increase timeout for slow environments (default: 30s)
# CLOUDDRIVE_TEST_TIMEOUT_SECONDS=60
